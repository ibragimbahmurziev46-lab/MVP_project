DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# AI (OpenAI-compatible API)
# Default: local Ollama — install from https://ollama.com, then:
#   ollama pull qwen3:27b
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen3:27b
AI_API_KEY=
AI_MAX_TOKENS=4000
AI_TIMEOUT=120

# Force template-based generation without calling the LLM
AI_MOCK=False